SECRET_KEY=django-insecure-noma-aesthetic-lifestyle-secret-key-genz-vibe
DEBUG=True
ALLOWED_HOSTS=*

# ================================================================
# Database Configuration (Choose MySQL, PostgreSQL, or SQLite)
# ================================================================

# Option A: MySQL / MariaDB (Local XAMPP / MySQL Workbench / Cloud MySQL)
DB_ENGINE=mysql
MYSQL_DATABASE=aesthetic_store_db
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Or MySQL Full Connection String:
# DATABASE_URL=mysql://root:password@127.0.0.1:3306/aesthetic_store_db

# Option B: Cloud PostgreSQL (e.g. Neon, Supabase, Render)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ================================================================
# Razorpay Payment Gateway Credentials
# ================================================================
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET

# ================================================================
# Email Configuration (e.g. Gmail App Password or SendGrid)
# ================================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=Aesthetic Store <your_email@gmail.com>

# ================================================================
# Google OAuth2 Credentials
# ================================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
