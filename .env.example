# ================================================================
# House of Aesthetics - Environment Configuration Template
# Copy this file to .env and configure your secret credentials.
# ================================================================

# ----------------------------------------------------------------
# 1. Django Core Settings
# ----------------------------------------------------------------
SECRET_KEY=your-custom-production-django-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=*
# CSRF_TRUSTED_ORIGINS=https://your-domain.up.railway.app,https://yourdomain.com

# ----------------------------------------------------------------
# 2. Initial Superuser Provisioning (used by python manage.py seed_data)
# ----------------------------------------------------------------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@housesofaesthetics.in
DJANGO_SUPERUSER_PASSWORD=YourSecureSuperuserPassword123!

# ----------------------------------------------------------------
# 3. Database Configuration
# ----------------------------------------------------------------
# Option A: Cloud PostgreSQL (Recommended for Railway / Supabase / Neon)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Option B: MySQL / MariaDB (Local XAMPP / Cloud MySQL)
# DB_ENGINE=mysql
# MYSQL_DATABASE=housesofaesthetics_db
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# Or full URL: DATABASE_URL=mysql://root:password@127.0.0.1:3306/housesofaesthetics_db

# Option C: Default SQLite (Default fallback if DATABASE_URL is not set)
# (No extra database configuration needed for SQLite)

# ----------------------------------------------------------------
# 4. Payment Gateway (Razorpay)
# Get keys at: https://dashboard.razorpay.com/app/keys
# ----------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# ----------------------------------------------------------------
# 5. Cloud HTTPS Email Services (Port 443 - 100% Unblockable on Railway)
# ----------------------------------------------------------------
# Option A: Brevo (Sendinblue) Transactional REST API (Free 300 emails/day)
# Get API key at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-YOUR_BREVO_API_KEY
BREVO_SENDER_EMAIL=support@housesofaesthetics.in
BREVO_SENDER_NAME=House of Aesthetics

# Option B: Resend REST API (Free 3,000 emails/month)
# Get API key at: https://resend.com/api-keys
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=House of Aesthetics <onboarding@resend.dev>

# ----------------------------------------------------------------
# 6. Standard SMTP Email Configuration (Port 587 / 465)
# Note: Cloud hosts like Railway block outbound SMTP 587/465.
# Use Brevo or Resend (Port 443) for cloud deployments.
# ----------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_gmail_app_password
DEFAULT_FROM_EMAIL=House of Aesthetics <support@housesofaesthetics.in>

# ----------------------------------------------------------------
# 7. Google OAuth2 Social Authentication
# Get credentials at: https://console.cloud.google.com/apis/credentials
# ----------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
